{
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@void/react": "1.9.1",
    "oxc-transform-react": ">=0.152.0 <0.157.0",
    "prettier": "^3.6.2",
